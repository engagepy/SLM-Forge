# Copy to .env and fill in. .env is gitignored.

# Agents (DataScout, DataPrep, Observer, Synth) use OpenAI by default.
OPENAI_API_KEY=

# Optional overrides
# SLM_AGENT_PROVIDER=openai        # or: claude (needs ANTHROPIC_API_KEY), ollama (fully offline)
# SLM_OPENAI_MODEL=gpt-6-luna      # model for the Tuner and helper agents
# SLM_OPENAI_TRACING=true          # agent traces in the OpenAI dashboard; false to keep them local
# ANTHROPIC_API_KEY=
# SLM_CLAUDE_MODEL=claude-opus-5
# SLM_OLLAMA_MODEL=qwen2.5:7b-instruct
# SLM_OLLAMA_URL=http://localhost:11434
# SLM_WORKSPACE=./workspace        # models, datasets, runs, exports and the SQLite DB
# SLM_PORT=8000

# Usage meter: USD per million tokens for the model above (input / cached input / output).
# SLM_OPENAI_PRICE_INPUT=2.00
# SLM_OPENAI_PRICE_CACHED=0.50
# SLM_OPENAI_PRICE_OUTPUT=8.00
