# Copy to .env and fill in. .env is gitignored.

# SLM_AGENT_PROVIDER picks the model for everything: the Tuner, its specialists, the AI judge and
# the Advanced agents. openai (default) needs OPENAI_API_KEY; claude needs ANTHROPIC_API_KEY;
# ollama (experimental: a local model, no key) needs Ollama running.
OPENAI_API_KEY=

# Hugging Face: needed for gated models (Llama, Gemma) and to publish models. A token that can
# write, from https://huggingface.co/settings/tokens. Or leave it unset and run `uv run hf auth login`.
# HF_TOKEN=hf_...

# Optional overrides
# SLM_AGENT_PROVIDER=openai        # openai | claude | ollama (experimental)
# SLM_OPENAI_MODEL=gpt-6-luna
# SLM_OPENAI_TRACING=true          # opt in: send full agent traces (prompts, tool calls, outputs) to the OpenAI dashboard
# ANTHROPIC_API_KEY=
# SLM_CLAUDE_MODEL=claude-fable-5-1
# SLM_OLLAMA_MODEL=qwen2.5:7b-instruct
# SLM_OLLAMA_URL=http://localhost:11434
# SLM_WORKSPACE=./workspace        # models, datasets, runs, exports and the SQLite DB
# SLM_PORT=8000

# Spend meter: reads your OpenAI account's real spend from the Costs API. Needs an organisation
# admin key (platform.openai.com → Organization → Admin keys). The meter finds the OpenAI project
# the API key belongs to by itself; set OPENAI_PROJECT_ID only to override that.
# OPENAI_ADMIN_KEY=sk-admin-...
# OPENAI_PROJECT_ID=proj_...
